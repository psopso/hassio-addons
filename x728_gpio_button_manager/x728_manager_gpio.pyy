import gpiod
from gpiod.line import Direction, Edge, Value
import time
import subprocess

# --- KONFIGURACE ---
CHIP_ID = 0
PIN_BUTTON = 5

def run_command(action):
    """Volání Bashio pro ovládání hostitele"""
    # Bashio příkazy se v HA add-onech spouštějí takto:
    cmd = ["bashio", f"host.{action}"]
    try:
        print(f"[X728] Executing {action} via Bashio...")
        subprocess.run(cmd, check=True)
    except Exception as e:
        print(f"Chyba při komunikaci s Bashio: {e}")

def main():
    print(f"[X728] Starting manager on gpiochip{CHIP_ID}....")

    # Nastavení parametrů pro vstupní pin
    line_settings = gpiod.LineSettings(
        direction=Direction.INPUT,
        edge_detection=Edge.BOTH
    )

    try:
        # Požadavek na linku (pin)
        with gpiod.request_lines(
            f"/dev/gpiochip{CHIP_ID}",
            consumer="x728-manager",
            config={PIN_BUTTON: line_settings}
        ) as lines:

            print("[X728] Ready, waiting for button press...")
            start_time = 0

            while True:
                # Čekání na událost (hranu)
                if lines.wait_edge_events(timeout=None):
                    for event in lines.read_edge_events():
                        
                        # Tlačítko stisknuto (Rising)
                        if event.event_type == gpiod.EdgeEvent.Type.RISING_EDGE:
                            start_time = time.time()
                        
                        # Tlačítko uvolněno (Falling)
                        elif event.event_type == gpiod.EdgeEvent.Type.FALLING_EDGE:
                            if start_time == 0: continue # Ignorovat náhodné kmity při startu
                            
                            duration = time.time() - start_time
                            print(f"[X728] Pulse: {duration:.3f}s")

                            if 0.2 <= duration <= 0.6:
                                run_command("reboot")
                                return
                            elif duration > 0.6:
                                run_command("shutdown")
                                return
    except Exception as e:
        print(f"Kritická chyba: {e}")


#if __name__ == "__main__":
main()
