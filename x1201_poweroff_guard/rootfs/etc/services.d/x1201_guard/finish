#!/usr/bin/with-contenv bashio
bashio::log.info "Spouštím finish..."

if [ -f /run/x1201-reboot ]; then
    bashio::log.info "AC was present -> reboot required"
#    bashio::api.supervisor POST /host/reboot
    nsenter --target 1 --mount --uts --ipc --net --pid echo "systemctl --force reboot"
    sleep 2
else
    bashio::log.info "AC was absent -> normal shutdown"
    nsenter --target 1 --mount --uts --ipc --net --pid echo "Vystup při AC was absent -> normal shutdown"
fi
