import smbus2
import time
import os
import sys
from luma.core.interface.serial import i2c
from luma.core.render import canvas
from luma.oled.device import ssd1306
from PIL import ImageFont

class YahboomHAT:
    """Třída pro ovládání Hardware funkcí (Fan, RGB) na adrese 0x0d"""
    ADDRESS = 0x0d
    REG_MODE = 0x00
    REG_SPEED = 0x01
    REG_RED = 0x02
    REG_GREEN = 0x03
    REG_BLUE = 0x04
    REG_FAN = 0x08

    def __init__(self, bus_n=1):
        try:
            self.bus = smbus2.SMBus(bus_n)
        except Exception as e:
            print(f"Chyba: Nelze otevřít I2C sběrnici: {e}")
            sys.exit(1)

    def set_fan(self, speed):
        """Nastaví rychlost ventilátoru 0 až 9"""
        speed = max(0, min(9, int(speed)))
        try:
            self.bus.write_byte_data(self.ADDRESS, self.REG_FAN, speed)
        except Exception as e:
            print(f"Chyba zápisu ventilátoru: {e}")

    def set_rgb(self, r, g, b):
        """Nastaví statickou barvu RGB"""
        try:
            self.bus.write_byte_data(self.ADDRESS, self.REG_MODE, 0x04)
            self.bus.write_byte_data(self.ADDRESS, self.REG_RED, int(r))
            self.bus.write_byte_data(self.ADDRESS, self.REG_GREEN, int(g))
            self.bus.write_byte_data(self.ADDRESS, self.REG_BLUE, int(b))
        except Exception as e:
            print(f"Chyba zápisu RGB: {e}")

    def set_rgb_off(self):
        try:
            self.bus.write_byte_data(self.ADDRESS, self.REG_MODE, 0x00)
        except Exception as e:
            print(f"Chyba vypnutí RGB: {e}")

def get_cpu_temp():
    """Přečte teplotu procesoru ze systému"""
    try:
        with open("/sys/class/thermal/thermal_zone0/temp", "r") as f:
            return float(f.read()) / 1000.0
    except:
        return 0.0

def get_ip():
    """Získá aktuální IP adresu (kompatibilní s Alpine/BusyBox)"""
    try:
        # Přepínač -i v BusyBoxu vypíše IP adresy oddělené mezerou
        f = os.popen("hostname -i")
        ip = f.read().strip().split(" ")[0]
        return ip if ip else "No IP"
    except:
        return "Error"
        
# --- INICIALIZACE OLED ---
try:
    serial = i2c(port=1, address=0x3C)
    device = ssd1306(serial)
    font = ImageFont.load_default()
    oled_enabled = True
except Exception as e:
    print(f"OLED displej nenalezen nebo chyba inicializace: {e}")
    oled_enabled = False

def update_display(device, temp, fan_speed):
    """Vykreslí informace na OLED"""
    with canvas(device) as draw:
        # Horní linka a titulek
        #draw.text((0, 20), "HA - COOLING HAT", font=font, fill="white")
        draw.text((0, 20), "HA", font=font, fill="white")
        #draw.line((0, 12, 128, 12), fill="white")
        
        # Hodnoty
        #draw.text((0, 18), f"IP: {get_ip()}", font=font, fill="white")
        #draw.text((0, 30), f"CPU Temp: {temp:.1f}C", font=font, fill="white")
        #draw.text((0, 42), f"Fan Speed: {fan_speed}/9", font=font, fill="white")
        
        # Spodní stavová lišta
        status = "COOLING" if fan_speed > 0 else "IDLE"
        #draw.text((0, 54), f"Status: {status}", font=font, fill="white")

# --- HLAVNÍ SMYČKA ---
if __name__ == "__main__":
    print("Spouštím Yahboom HAT Control (Fan + RGB + OLED)...")
    hat = YahboomHAT()
    
    # Úvodní bliknutí a logo
    hat.set_rgb(0, 255, 0) # Zelená pro start
    
    try:
        while True:
            temp = get_cpu_temp()
            
            # Logika chlazení a barev
            if temp >= 60:
                fan_speed = 9
                hat.set_rgb(255, 0, 0) # Červená
            elif temp >= 50:
                fan_speed = 6
                hat.set_rgb(255, 128, 0) # Oranžová
            elif temp >= 42:
                fan_speed = 3
                hat.set_rgb(0, 0, 255) # Modrá
            else:
                fan_speed = 0
                hat.set_rgb_off()

            print(f"CPU: {temp:.1f}°C -> Fan Speed: {fan_speed}")
            # Aplikace rychlosti ventilátoru
            hat.set_fan(fan_speed)
            
            # Update displeje
            if oled_enabled:
                try:
                    update_display(device, temp, fan_speed)
                except Exception as e:
                    print(f"Chyba při aktualizaci OLED: {e}")

            # Interval měření (5 sekund)
            time.sleep(5)
            
    except KeyboardInterrupt:
        print("Ukončování...")
        hat.set_fan(0)
        hat.set_rgb_off()
        